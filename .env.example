# =============================================================================
# Peepal Flow Fix Solutions - environment template
# Copy to .env and fill real values. NEVER commit the populated .env file.
# =============================================================================

# ---- Core -------------------------------------------------------------------
# PostgreSQL connection string (RDS in production)
DATABASE_URL="postgresql://user:password@host:5432/flowcraft?schema=public"
# Public base URL of the site, used for canonical URLs, sitemap and links
NEXT_PUBLIC_SITE_URL="https://www.peepalflowfix.in"
NODE_ENV="production"

# ---- Auth -------------------------------------------------------------------
# Secret used to sign session JWTs. Generate: openssl rand -base64 48
AUTH_SECRET=""

# ---- Business identity (public contact info shown on the website) ----------
NEXT_PUBLIC_BUSINESS_NAME="Peepal Flow Fix Solutions"
NEXT_PUBLIC_BUSINESS_PHONE="+919XXXXXXXXX"
NEXT_PUBLIC_BUSINESS_WHATSAPP="+919XXXXXXXXX"
NEXT_PUBLIC_BUSINESS_EMAIL="hello@yourdomain.in"
# Legitimate Google review link from your Google Business Profile
GOOGLE_REVIEW_URL=""

# ---- Storage ---------------------------------------------------------------
# STORAGE_DRIVER: "local" (single-node dev) or "s3" (production)
STORAGE_DRIVER="s3"
STORAGE_LOCAL_DIR="./.data/uploads"
S3_BUCKET="peepalflowfix-uploads"
S3_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ---- Messaging providers ----------------------------------------------------
# Official WhatsApp Business Platform (Meta Cloud API). Leave blank to disable.
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
SMS_API_KEY=""
EMAIL_API_KEY=""
# Where internal alerts (new enquiry) are delivered. Blank = log only.
ADMIN_ALERT_EMAIL=""
ADMIN_ALERT_SMS=""
OWNER_ALERT_PHONE=""

# ---- Background jobs --------------------------------------------------------
# Shared secret for POST /api/cron/process
CRON_SECRET=""
REVIEW_REQUEST_DELAY_DAYS="2"

# ---- Development seeds (change immediately outside local dev) --------------
SEED_ADMIN_PASSWORD=""
SEED_STAFF_PASSWORD=""
SEED_FIELD_PASSWORD=""
